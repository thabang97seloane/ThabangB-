# ── AI (required for real AI generation) ──────────────────────────────
# Get a key at https://console.anthropic.com → API Keys.
# Without it, LEZWAI runs in "demo mode" using a built-in template generator.
ANTHROPIC_API_KEY=

# ── Payments (optional, for the paid plans) ───────────────────────────
# https://dashboard.stripe.com/apikeys  (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Create a recurring Price for each plan in Stripe → Products, then paste the price IDs.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Public URL of your site (used for Stripe redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
